{
  "name": "dogfood-backend",
  "version": "1.0.0",
  "description": "DOGFOOD 2026 Hackathon Management Platform Backend",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
