# -----------------------------------------------------------------------------
# DOGFOOD 2026 configuration. Copy to .env (setup.sh / setup.bat do this for you
# and fill in random secrets). Every value is optional for `docker compose up`.
# -----------------------------------------------------------------------------

# PostgreSQL 16 (Compose builds the backend DATABASE_URL from these three)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dogfood

# Only used when running the backend natively (npm run dev) against a local DB.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dogfood?schema=public"

# Backend
PORT=4000
# Compose always runs the backend with NODE_ENV=production; this applies to native runs.
NODE_ENV=development
# Leave empty under Docker to auto-generate random secrets on first boot
# (persisted in the backend_secrets volume). Must be >= 32 random chars in production.
JWT_SECRET=
COOKIE_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
# Express "trust proxy": which upstream proxies may set X-Forwarded-For.
TRUST_PROXY=loopback, linklocal, uniquelocal
# Session cookie Secure flag: auto (follow request protocol), true, or false.
COOKIE_SECURE=auto
# Seed demo users and the demo event when the database is empty (true/false).
SEED_DEMO_DATA=true

# Frontend (baked in at build time). /api is proxied by Nginx / the Vite dev server.
VITE_API_URL=/api
